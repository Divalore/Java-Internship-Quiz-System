<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox stylesheets="@style.css" xmlns="http://javafx.com/javafx"
xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.quizsystem.controller.ManageQuestionsController"
spacing="15" style="-fx-padding:30;" alignment="CENTER">

    <Label text="Manage Questions" style="-fx-font-size:24px; -fx-font-weight:bold;">

    </Label>
    <TableView fx:id="questionsTable" prefHeight="500" prefWidth="900">
        <columns>
            <TableColumn fx:id="colExam" text="Exam Title" prefWidth="200">
            </TableColumn>
            <TableColumn fx:id="colQuestion" text="Question" prefWidth="500"></TableColumn>
            <TableColumn fx:id="colCorrect" text="Correct Answer" prefWidth="200"></TableColumn>
        </columns>
    </TableView>
    <Button text="Edit Selected Questions" onAction="#editQuestion" prefWidth="300"
    style="-fx-font-size:15px; -fx-background-color:#3498DB; -fx-text-fill:white;">
    </Button>
    <Button text="Delete Selected Question" onAction="#deleteQuestion" prefWidth="300"
    style="-fx-font-size: 15px; -fx-background-color:#E74C3C; -fx-text-fill: white;"></Button>

</VBox>
