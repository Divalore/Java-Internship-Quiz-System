<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox stylesheets="@style.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com.fxml"
      fx:controller="com.example.quizsystem.controller.ViewResultsController" spacing="15"
      style="-fx-padding:30;" alignment="CENTER">

    <Label text="Exam Results" style="-fx-font-size: 24px; -fx-font-weight:bold;"></Label>

    <TableView fx:id="resultsTable" prefWidth="600" prefHeight="400">
        <columns>
            <TableColumn fx:id="colEmail" text="Student Email" prefWidth="300">
            </TableColumn>
            <TableColumn fx:id="colScore" text="Score" prefWidth="150">
            </TableColumn>
            <TableColumn fx:id="colTotal" text="Total Questions" prefWidth="150">
            </TableColumn>
        </columns>

    </TableView>



</VBox>