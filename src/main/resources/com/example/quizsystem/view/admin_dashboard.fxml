<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://java.com/fxml"
            fx:controller="com.example.quizsystem.controller.AdminController"
            style="-fx-padding: 20;">

    <top>
        <Label text="Admin Dashboard"
               style="-fx-font-size: 20px;
               -fx-font-weight:bold;"></Label>
    </top>
    <left>
        <VBox stylesheets="@style.css" spacing="10" style="-fx-padding: 20;">
            <Button text="Create Exam" prefWidth="200" style="-fx-font-size:14px;" onAction="#openCreateExam"></Button>
            <Button text="Manage Questions" onAction="#openManageQuestions" prefWidth="200" style="-fx-font-size:14px;"></Button>
            <Button text="View Results" onAction="#openViewResults" prefWidth="200" style="-fx-font-size:14px;"></Button>
            <Button onAction="#registerNewStudent" text="Register New Student" prefWidth="200" style="-fx-font-size:14px;">
            </Button>
            <Button onAction="#handleLogout" text="Logout" prefWidth="200"
                    style="-fx-font-size:14px; -fx-background-color: #E74C3C">

            </Button>
        </VBox>
    </left>
</BorderPane>
